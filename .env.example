# Email verification (SMTP). All server-side; registration still works
# without SMTP, but the confirmation email is only logged on the server.
# To actually deliver confirmation links, fill in a real SMTP account.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Velora <no-reply@veloraai.pro>

# Infini: enable only after merchant, refund and token-expiry launch review
INFINI_ENABLED=false
INFINI_KEY_ID=
INFINI_SECRET_KEY=
INFINI_WEBHOOK_SECRET=
INFINI_API_BASE_URL=https://openapi.infini.money
INFINI_CHECKOUT_ORIGIN=https://checkout.infini.money
APP_BASE_URL=https://veloraai.pro

# Bank transfer (IBAN): fill real seller details before commercial launch.
BANK_TRANSFER_ENABLED=false
BANK_SELLER_NAME=
BANK_SELLER_IBAN=
BANK_SELLER_BIC=
BANK_SELLER_BANK=
BANK_SELLER_COUNTRY=
BANK_SELLER_ADDRESS=
BANK_TERMS_VERSION=2026-10-26-v1
BANK_TERMS_TEXT=DRAFT — replace BANK_TERMS_VERSION and BANK_TERMS_TEXT before commercial launch.
BANK_TOKEN_VALIDITY_MONTHS=12
BANK_CREDIT_DAYS_AFTER_RECEIPT=2
BANK_EVIDENCE_DIR=/home/user/velora-ai/.bank-evidence
BANK_MAIL_FROM=Velora <no-reply@veloraai.pro>
