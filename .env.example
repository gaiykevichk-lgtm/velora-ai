# Resend email delivery (server-side only). Set RESEND_API_KEY in the host environment.
# With RESEND_API_KEY the app sends through the Resend HTTPS API (port 443);
# without it the code falls back to SMTP smtp.resend.com:587 with user "resend".
RESEND_API_KEY=
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=
SMTP_FROM=Velora <no-reply@veloraai.pro>

